# Dead Letters - Environment Configuration
#
# Copy this file to .env and fill in your values.
# The .env file is gitignored and will not be committed.

# =============================================================================
# PRODUCTION MODE (Recommended for App Store / Play Store)
# =============================================================================
# Your Vercel proxy URL, including the /api/gemini path.
# Deploy the proxy first (see proxy/README.md), then put the real URL here.
# IMPORTANT: replace the example below with YOUR deployment — the app cannot
# reach a placeholder host (e.g. "...vercel.app/api/gemini" must be real).
GEMINI_PROXY_URL=https://your-project.vercel.app/api/gemini

# Optional: Add extra authentication between your app and proxy
# Generate a random string and add it to both here AND your Vercel env vars
# APP_TOKEN=your_random_secret_token_here

# =============================================================================
# DEVELOPMENT MODE (Local testing only - NOT secure for distribution)
# =============================================================================
# Direct Gemini API key - ONLY use this for local development
# Get your key from: https://aistudio.google.com/
# WARNING: This key will be embedded in the app binary if used
# GEMINI_API_KEY=your_gemini_api_key_here

# Analytics (optional): PostHog project key + host. Without a key, analytics
# stay local (no network calls). https://posthog.com — free tier is plenty.
# POSTHOG_API_KEY=phc_xxxxxxxxxxxx
# POSTHOG_HOST=https://us.i.posthog.com

# ========== IN-APP PURCHASES (optional) ==========
# RevenueCat public SDK keys. Leave unset to run the mock purchase backend;
# PurchaseService warns loudly rather than configuring with a placeholder.
# REVENUECAT_APPLE_KEY=appl_xxx
# REVENUECAT_GOOGLE_KEY=goog_xxx

# ========== LOCAL DEV / TERMUX (optional) ==========
# Expo globs the whole project for **/*.@(ts|tsx) (ignoring node_modules and
# *.d.ts). A single stray .ts file anywhere — a scratch file, a `vercel dev`
# artifact under .vercel/ — makes `expo start` demand typescript +
# @types/react. This project is pure JavaScript, and DECLINING THE PROMPT DOES
# NOT PROCEED: it raises a CommandError and the dev server exits. Set this to
# skip the check outright.
# EXPO_NO_TYPESCRIPT_SETUP=1
